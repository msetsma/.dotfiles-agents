# =============================================================================
# .agentdots - single .gitignore for the whole repo (all sub-projects included)
# =============================================================================

# dotter runtime state
.dotter/cache.toml
.dotter/cache/
.dotter/local.toml

# machine-local catalog values (copy catalog/local.toml.example)
catalog/local.toml

# Python environments, caches, build artifacts
.venv/
*.egg-info/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.uv/
dist/
build/

# teams-mcp/.ori working dir (session history + logs)
/mcp/teams-mcp/.ori/

# SQLite databases and their WAL/SHM/journal sidecars - never commit these
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal
*.sqlite3
*.db
*.db-shm
*.db-wal

# macOS
.DS_Store
