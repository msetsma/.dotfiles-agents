# =============================================================================
# .dotfiles-agents - single .gitignore for the whole repo (all sub-projects included)
# =============================================================================

# machine-local catalog values (copy catalog/local.toml.example)
catalog/local.toml

# Python environments, caches, build artifacts
.venv/
*.egg-info/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.uv/
dist/
build/

# MCP server repos cloned by `make agent-update` (see catalog/mcp/*.toml [package])
/vendor/

# SQLite databases and their WAL/SHM/journal sidecars - never commit these
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal
*.sqlite3
*.db
*.db-shm
*.db-wal

# Node (pi packages)
node_modules/

# macOS
.DS_Store
