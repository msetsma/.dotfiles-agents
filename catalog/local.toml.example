# Machine-local catalog values - UNTRACKED.
#
# Copy this file to `catalog/local.toml` and fill in your own values. Anything
# here overrides catalog/paths.toml, so org-specific settings never land in the
# published repo.

[vars]
# Azure DevOps organization slug used by the azure-devops server.
ADO_ORG = "your-ado-org"

# Repo checkout path on Windows. Use forward slashes: hook commands run under
# bash, which reads backslashes as escapes.
# AGENT_HOME = "C:/Users/<you>/.dotfiles-agents"

# --------------------------------------------------------------------------- #
# Per-machine profile (optional). Leave these out on the primary machine: with
# no [profile] every catalog item syncs to every client.
# --------------------------------------------------------------------------- #

# [profile]
# clients      = ["claude-code", "claude-desktop"]  # or "auto": see below
# exclude_tags = ["work", "macos"]                   # catalog `tags = [...]`: work, macos, personal
# exclude      = ["obscura", "python-clean", "python-clean-stop"]  # names, any kind
#
# "auto" keeps a client when the parent directory of any of its configured
# paths exists; claude-code always matches (~/.claude.json sits in home).
# The python-clean hooks run bin/clean-python under bash, so Windows excludes
# them along with the python-clean opencode plugin.

# Command overrides; a list becomes command + leading args (Windows needs
# `cmd /c` in front of npx). They also apply to `[package] build` steps, so
# `npm` and `node` can point at a specific Node (on Windows, Node Current for
# the spotify build).
# [commands]
# uv   = "C:/Users/me/.local/bin/uv.exe"
# npx  = ["cmd", "/c", "npx"]
# node = "C:/Program Files/nodejs/node.exe"
# npm  = ["cmd", "/c", "C:/Program Files/nodejs/npm.cmd"]

# Deep-merged over catalog/clients.toml.
# [clients.claude-desktop.mcp]
# path        = "~/AppData/Roaming/Claude/claude_desktop_config.json"
# inject_path = ""

# Deep-merged over catalog/<kind>/<name>.toml (mcp, skills, plugins, hooks,
# instructions).
# [mcp.playwright]
# clients = ["claude-code", "claude-desktop"]
#
# [mcp.notes.env]
# VAULT_PATH = "C:/Users/me/vault"
