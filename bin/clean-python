#!/usr/bin/env bash
# clean-python - one gate for agent-written Python, shared by every client.
#
# Auto-fixes and formats what ruff can, then reports anything that is left so
# the model has to fix it. Suppressions (`# noqa`) are deliberately ignored on
# the final pass: the only accepted resolution is a real fix.
#
# After ruff, bin/python_gate.py runs the checks ruff cannot express: file
# length, mutable dataclasses, dead code only tests use (vulture), and type
# errors (ty). Its findings join ruff's in the same report.
#
# Config: the gate resolves ruff's config explicitly from the *git project root*
# (ruff.toml, .ruff.toml, or a pyproject.toml with a [tool.ruff] section). When
# the project root has no such file the global ruff config is used; when that is
# absent too, ruff's built-in defaults apply. Resolving it explicitly keeps a
# stray config in a parent directory from silently changing the rules.
#
# Five ways in, so a single implementation serves every client:
#   clean-python <path>          explicit file (used by the opencode plugin)
#   ... | clean-python           Claude Code PostToolUse JSON on stdin
#   clean-python --stop-check    Claude Code Stop JSON on stdin
#   clean-python --waive <path>  record a user-approved "off-topic" skip
#   clean-python --staged        check staged Python files, no fixes (git
#                                pre-commit; see githooks/pre-commit)
#
# Tests also probe resolution through internal `--config-for <path>` and
# `--ruff-for <path>` modes, which print the config / ruff binary this gate
# would use.
#
# Exit 0: clean / auto-fixed / not a Python file / no pending residue (no-op).
# Exit 2: something auto-fix could not resolve -> report on stderr. For
#         --stop-check, exit 2 also refuses the Stop hook, forcing another turn.
#         For --staged, exit 1 when a staged file fails, which aborts the commit.
#
# The opencode plugin injects its own follow-up prompt when this exits 2, and
# its python_clean_skip tool calls `--waive` once the user approves skipping an
# off-topic file. Claude Code has no such tool, so PostToolUse records every
# still-broken file in a per-session state file and the Stop hook re-checks them
# before the turn may end. A waiver is keyed by the file's current findings, so
# it sticks across turns but expires as soon as the code changes. A file is
# dropped once it passes, is waived, or after MAX_BLOCKS refused stops, so a
# problem the agent cannot fix cannot trap the session forever.
set -uo pipefail

MAX_BLOCKS=3
state_dir="${TMPDIR:-/tmp}/clean-python"
gate_script="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/python_gate.py"

# --------------------------------------------------------------------------- #
# ruff + config resolution
# --------------------------------------------------------------------------- #
ruff_for() {
    # Print the ruff binary to use for $1: project venv first (bin/ on POSIX,
    # Scripts/ on Windows), then $RUFF, then PATH.
    local target="$1" root candidate
    root="$(git -C "$(dirname "$target")" rev-parse --show-toplevel 2>/dev/null || true)"
    if [[ -n "$root" ]]; then
        for candidate in "$root/.venv/bin/ruff" "$root/.venv/Scripts/ruff.exe"; do
            if [[ -x "$candidate" ]]; then
                printf '%s' "$candidate"
                return
            fi
        done
    fi
    if [[ -n "${RUFF:-}" && -x "$RUFF" ]]; then
        printf '%s' "$RUFF"
        return
    fi
    command -v ruff || true
}

project_root_for() {
    # Git project root for $1, or the file's own directory outside a repo.
    local target="$1" dir root
    if dir="$(cd "$(dirname "$target")" 2>/dev/null && pwd)"; then :; else dir="$(dirname "$target")"; fi
    root="$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null || true)"
    printf '%s' "${root:-$dir}"
}

project_config_for() {
    # Print the project-level ruff config for $1 when the git root has one.
    local target="$1" root candidate
    root="$(project_root_for "$target")"
    for candidate in "$root/ruff.toml" "$root/.ruff.toml"; do
        if [[ -f "$candidate" ]]; then
            printf '%s' "$candidate"
            return 0
        fi
    done
    candidate="$root/pyproject.toml"
    if [[ -f "$candidate" ]] && grep -q '^\[tool\.ruff' "$candidate" 2>/dev/null; then
        printf '%s' "$candidate"
        return 0
    fi
    return 1
}

global_config() {
    # Ruff's user-level config, the fallback when the project root has none:
    # ~/.config/ruff on macOS and Linux, %APPDATA%/ruff on Windows.
    local cfg appdata="${APPDATA:-}"
    if [[ -n "$appdata" ]] && command -v cygpath >/dev/null 2>&1; then
        appdata="$(cygpath -u "$appdata")"
    fi
    for cfg in "${XDG_CONFIG_HOME:-$HOME/.config}/ruff/ruff.toml" ${appdata:+"$appdata/ruff/ruff.toml"}; do
        if [[ -f "$cfg" ]]; then
            printf '%s' "$cfg"
            return 0
        fi
    done
    return 1
}

config_for() {
    # Single config path for $1: project root first, then the global config.
    local cfg
    cfg="$(project_config_for "$1" || true)"
    [[ -n "$cfg" ]] || cfg="$(global_config || true)"
    printf '%s' "$cfg"
}

package_dir_for() {
    # Nearest directory at or above $1 holding a pyproject.toml, stopping at the
    # git root; the file's own directory when there is none.
    local target="$1" dir root
    if dir="$(cd "$(dirname "$target")" 2>/dev/null && pwd)"; then :; else
        printf '%s' "$(dirname "$target")"
        return
    fi
    root="$(project_root_for "$target")"
    local here="$dir"
    while :; do
        if [[ -f "$here/pyproject.toml" ]]; then
            printf '%s' "$here"
            return
        fi
        [[ "$here" == "$root" || "$here" == / ]] && break
        here="$(dirname "$here")"
    done
    printf '%s' "$dir"
}

ruff_run() {
    # Run ruff for $1 with $ruff_bin from the file's package directory (see
    # package_dir_for). A user-level config resolves `src` and infers
    # target-version from the cwd, so this matches a plain `ruff check` run
    # from the package, and the report stays cwd-independent. The remaining
    # arguments are the ruff subcommand + flags. Config is pinned to the
    # project root when present, else the global config, else --isolated
    # (built-in defaults) so a stray config can never leak in.
    local target="$1"
    shift
    local dir base abs cfg
    dir="$(package_dir_for "$target")"
    base="$(basename "$target")"
    if abs="$(cd "$(dirname "$target")" 2>/dev/null && pwd)"; then base="${abs}/${base}"; base="${base#"$dir"/}"; fi
    cfg="$(config_for "$target")"
    if [[ -n "$cfg" ]]; then
        (cd "$dir" && "$ruff_bin" "$@" --config "$cfg" "$base" 2>&1)
    else
        (cd "$dir" && "$ruff_bin" "$@" --isolated "$base" 2>&1)
    fi
}

gate_runner=()
gate_runner_probed=0

gate_python() {
    # Fill gate_runner with the interpreter for bin/python_gate.py, which needs
    # Python >= 3.14: uv's 3.14 first, then a python on PATH that is new enough.
    # Probed once per run; leaves gate_runner empty when there is none.
    [[ $gate_runner_probed -eq 1 ]] && return
    gate_runner_probed=1
    local candidate
    if command -v uv >/dev/null 2>&1 && uv run --no-project --quiet --python 3.14 python -c '' >/dev/null 2>&1; then
        gate_runner=(uv run --no-project --quiet --python 3.14 python)
        return
    fi
    for candidate in python3 python; do
        if "$candidate" -c 'import sys; sys.exit(sys.version_info < (3, 14))' >/dev/null 2>&1; then
            gate_runner=("$candidate")
            return
        fi
    done
}

native_path() {
    # Windows Python cannot read MSYS paths (/c/Users/...); convert when cygpath exists.
    if command -v cygpath >/dev/null 2>&1; then cygpath -w "$1"; else printf '%s' "$1"; fi
}

run_gate() {
    # Run bin/python_gate.py with the remaining arguments; empty runner -> 127.
    gate_python
    [[ ${#gate_runner[@]} -gt 0 ]] || return 127
    PYTHONUTF8=1 "${gate_runner[@]}" "$gate_script" "$@"
}

gate_report() {
    # Run bin/python_gate.py on $1 (package dir for ty, git root for vulture).
    # Prints findings and returns 1 only when it exited 1 *and* reported
    # something; anything else (no Python >= 3.14, a crash, an unreadable file)
    # is a skipped check with a warning, never a block.
    local out status
    out="$(run_gate "$(native_path "$1")" "$(native_path "$(package_dir_for "$1")")" "$(native_path "$(project_root_for "$1")")")"
    status=$?
    if [[ $status -eq 1 && -n "$out" ]]; then
        printf '%s\n' "$out"
        return 1
    fi
    if [[ $status -eq 127 ]]; then
        echo "clean-python: no Python >= 3.14 (or uv) found; skipping the non-ruff checks" >&2
    elif [[ $status -ne 0 ]]; then
        echo "clean-python: python_gate.py failed (exit $status) on $1; non-ruff checks skipped" >&2
    fi
    return 0
}

check_report() {
    # Run ruff, then bin/python_gate.py, on $1 with $ruff_bin; set RUFF_REPORT
    # and return non-zero when either finds something. Note: ruff prints "All
    # checks passed!" on a clean run, so callers must test the exit status, not
    # whether RUFF_REPORT is empty.
    local ruff_out gate_out ruff_status gate_status
    ruff_out="$(ruff_run "$1" check --ignore-noqa --output-format concise)"
    ruff_status=$?
    gate_out="$(gate_report "$1")"
    gate_status=$?
    if [[ $gate_status -eq 0 ]]; then
        RUFF_REPORT="$ruff_out"
    elif [[ $ruff_status -eq 0 ]]; then
        RUFF_REPORT="$gate_out"
    else
        RUFF_REPORT="$ruff_out"$'\n'"$gate_out"
    fi
    [[ $ruff_status -eq 0 && $gate_status -eq 0 ]]
}

fix_and_format() {
    # Auto-fix + format $1, using $ruff_bin and its resolved config.
    ruff_run "$1" check --fix --quiet >/dev/null 2>&1 || true
    ruff_run "$1" format --quiet >/dev/null 2>&1 || true
}

python_bin() {
    # First working interpreter: python3, then python. Windows ships a python3
    # Store stub that only prints an install hint, so each must run to count.
    local candidate
    for candidate in python3 python; do
        if "$candidate" -c '' >/dev/null 2>&1; then
            printf '%s' "$candidate"
            return 0
        fi
    done
    return 1
}

require_python() {
    # Print a working interpreter, or warn on stderr and fail. The callers exit
    # 0 on failure: a missing python skips the gate but never blocks the agent.
    python_bin && return 0
    echo "clean-python: no working python found; skipping the gate" >&2
    return 1
}

is_python() {
    case "$1" in
        *.py | *.pyi) return 0 ;;
        *) return 1 ;;
    esac
}

state_file() {
    printf '%s/pending-%s' "$state_dir" "$(printf '%s' "$1" | tr -cd 'A-Za-z0-9._-')"
}

record_pending() {
    # $1 session id, $2 path. Idempotent; the counter belongs to --stop-check.
    local sf
    sf="$(state_file "$1")"
    mkdir -p "$state_dir" || return 0
    if [[ -f "$sf" ]] && cut -f2- "$sf" | grep -qxF "$2"; then
        return 0
    fi
    printf '0\t%s\n' "$2" >>"$sf"
}

digest() {
    # sha256 of $1. Hook environments may lack shasum (Git Bash keeps it
    # outside the default PATH), so prefer sha256sum.
    if command -v sha256sum >/dev/null 2>&1; then
        printf '%s' "$1" | sha256sum | awk '{print $1}'
    else
        printf '%s' "$1" | shasum -a 256 | awk '{print $1}'
    fi
}

abs_path() {
    local dir
    if dir="$(cd "$(dirname "$1")" 2>/dev/null && pwd -P)"; then
        printf '%s/%s' "$dir" "$(basename "$1")"
    else
        printf '%s' "$1"
    fi
}

settled_file() {
    printf '%s/settled-%s' "$state_dir" "$(printf '%s' "$1" | tr -cd 'A-Za-z0-9._-')"
}

mtime_of() {
    date -r "$1" +%s 2>/dev/null || echo 0
}

settle() {
    # $1 session, $2 path: the file is done (clean, waived or given up) at its
    # current mtime, so the session scan does not re-add it until it changes.
    mkdir -p "$state_dir" || return 0
    printf '%s\t%s\n' "$(mtime_of "$2")" "$2" >>"$(settled_file "$1")"
}

is_settled() {
    local sf
    sf="$(settled_file "$1")"
    [[ -f "$sf" ]] && grep -qxF "$(mtime_of "$2")"$'\t'"$2" "$sf"
}

waiver_file() {
    # One waiver per absolute path; contents are the findings digest it covers.
    printf '%s/waived-%s' "$state_dir" "$(digest "$(abs_path "$1")")"
}

is_waived() {
    # $1 file, $2 its current findings. True when a waiver matches that digest.
    local wf
    wf="$(waiver_file "$1")"
    [[ -f "$wf" ]] || return 1
    [[ "$(cat "$wf" 2>/dev/null)" == "$(digest "$2")" ]]
}

# --------------------------------------------------------------------------- #
# Probe modes: print the ruff config / binary this gate resolves for a path
# --------------------------------------------------------------------------- #
if [[ "${1:-}" == "--config-for" ]]; then
    config_for "${2:-}"
    exit 0
fi
if [[ "${1:-}" == "--ruff-for" ]]; then
    ruff_for "${2:-}"
    exit 0
fi

# --------------------------------------------------------------------------- #
# Waive mode: record a user-approved skip for one file's current findings
# --------------------------------------------------------------------------- #
if [[ "${1:-}" == "--waive" ]]; then
    target="${2:-}"
    [[ -n "$target" && -f "$target" ]] || exit 0
    is_python "$target" || exit 0
    target="$(abs_path "$target")"
    ruff_bin="$(ruff_for "$target")"
    [[ -n "$ruff_bin" ]] || exit 0
    if check_report "$target"; then
        echo "clean-python: $(basename "$target") is already clean; nothing to waive." >&2
        exit 0
    fi
    report="$RUFF_REPORT"
    mkdir -p "$state_dir" || exit 0
    digest "$report" >"$(waiver_file "$target")"
    echo "clean-python: waived $(basename "$target") for its current findings." >&2
    exit 0
fi

# --------------------------------------------------------------------------- #
# Staged mode: git pre-commit check of every staged Python file, no fixes.
# The checks read the working-tree copy, so a staged file that also has
# unstaged changes is refused: what would be committed is not what was checked.
# Waivers do not apply here; `git commit --no-verify` is the deliberate escape.
# --------------------------------------------------------------------------- #
if [[ "${1:-}" == "--staged" ]]; then
    repo="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
    failed=0
    while IFS= read -r -d '' rel; do
        target="$repo/$rel"
        is_python "$target" && [[ -f "$target" ]] || continue
        ruff_bin="$(ruff_for "$target")"
        if [[ -z "$ruff_bin" ]]; then
            echo "clean-python: ruff not found; skipping $rel" >&2
            continue
        fi
        if ! git -C "$repo" diff --quiet -- "$rel"; then
            echo "$rel: has unstaged changes; stage them (or stash them) so the check sees what you commit" >&2
            failed=1
            continue
        fi
        problems=""
        check_report "$target" || problems="$RUFF_REPORT"$'\n'
        if ! ruff_run "$target" format --check --quiet >/dev/null; then
            problems+="$rel: not formatted (run: ruff format $rel)"$'\n'
        fi
        if [[ -n "$problems" ]]; then
            printf '%s' "$problems" >&2
            failed=1
        fi
    done < <(git -C "$repo" diff --cached --name-only -z --diff-filter=ACMR)
    if [[ $failed -ne 0 ]]; then
        echo "clean-python: commit refused; fix the findings above (suppressions are ignored)." >&2
        exit 1
    fi
    exit 0
fi

# --------------------------------------------------------------------------- #
# Stop mode: refuse to finish while Python written this session still fails
# --------------------------------------------------------------------------- #
if [[ "${1:-}" == "--stop-check" ]]; then
    payload="$(cat)"
    [[ -n "$payload" ]] || exit 0
    python="$(require_python)" || exit 0
    parsed="$(printf '%s' "$payload" | "$python" -c '
import json, sys
try:
    doc = json.load(sys.stdin)
except ValueError:
    doc = {}
for key in ("session_id", "transcript_path", "cwd"):
    print(doc.get(key) or "")
' 2>/dev/null)" || exit 0
    session="$(printf '%s\n' "$parsed" | sed -n '1p')"
    transcript="$(printf '%s\n' "$parsed" | sed -n '2p')"
    cwd="$(printf '%s\n' "$parsed" | sed -n '3p')"
    [[ -n "$session" ]] || exit 0

    sf="$(state_file "$session")"
    # Files written through the shell never reach PostToolUse: add every dirty
    # Python file changed since the session started, unless it already passed
    # (or was given up on) at its current mtime.
    if [[ -n "$transcript" && -n "$cwd" ]]; then
        while IFS= read -r changed; do
            [[ -n "$changed" ]] || continue
            command -v cygpath >/dev/null 2>&1 && changed="$(cygpath -u "$changed")"
            changed="$(abs_path "$changed")"
            is_settled "$session" "$changed" || record_pending "$session" "$changed"
        done < <(run_gate --session-changes "$(native_path "$transcript")" "$(native_path "$cwd")" 2>/dev/null)
    fi
    [[ -f "$sf" ]] || exit 0

    pending=""
    findings=""
    while IFS=$'\t' read -r count path; do
        [[ -n "$path" && -f "$path" ]] || continue
        path="$(abs_path "$path")"
        ruff_bin="$(ruff_for "$path")"
        [[ -n "$ruff_bin" ]] || continue
        report=""
        if check_report "$path"; then
            rm -f "$(waiver_file "$path")"
            settle "$session" "$path"
            continue # clean -> drop, and clear any stale waiver
        fi
        report="$RUFF_REPORT"
        if is_waived "$path" "$report"; then
            settle "$session" "$path"
            continue # user approved skipping this off-topic file
        fi
        count=$((count + 1))
        if [[ "$count" -le "$MAX_BLOCKS" ]]; then
            pending+="${count}"$'\t'"${path}"$'\n'
            findings+="$report"$'\n'
        else
            settle "$session" "$path" # given up: only a new edit brings it back
        fi
    done <"$sf"

    if [[ -n "$pending" ]]; then
        printf '%s' "$pending" >"$sf"
        {
            echo "clean-python: Python you wrote still has findings that auto-fix could not resolve."
            echo
            printf '%s' "$findings"
            echo "Fix the code itself. Suppression (# noqa) is ignored on this check."
            echo "If the file is off-topic, ask the user for permission and then skip it with:"
            echo "  $0 --waive <file>"
        } >&2
        exit 2
    fi

    rm -f "$sf"
    exit 0
fi

# --------------------------------------------------------------------------- #
# target + session
# --------------------------------------------------------------------------- #
target=""
session=""
if [[ -n "${1:-}" ]]; then
    target="$1"
else
    payload="$(cat)"
    [[ -n "$payload" ]] || exit 0
    python="$(require_python)" || exit 0
    parsed="$(printf '%s' "$payload" | "$python" -c '
import json, sys
try:
    doc = json.load(sys.stdin)
except Exception:
    sys.exit(0)
tool_input = doc.get("tool_input") or {}
tool_response = doc.get("tool_response") or {}
print(tool_input.get("file_path") or tool_response.get("filePath") or tool_response.get("file_path") or "")
print(doc.get("session_id") or "")
' 2>/dev/null)" || exit 0
    target="$(printf '%s\n' "$parsed" | sed -n '1p')"
    session="$(printf '%s\n' "$parsed" | sed -n '2p')"
fi

[[ -n "$target" ]] || exit 0
is_python "$target" || exit 0
[[ -f "$target" ]] || exit 0
target="$(abs_path "$target")"

ruff_bin="$(ruff_for "$target")"
if [[ -z "$ruff_bin" ]]; then
    echo "clean-python: ruff not found; skipping $(basename "$target")" >&2
    exit 0
fi

# --------------------------------------------------------------------------- #
# fix what we can, then verify with suppressions ignored
# --------------------------------------------------------------------------- #
fix_and_format "$target"

if check_report "$target"; then
    rm -f "$(waiver_file "$target")"
    exit 0
fi
report="$RUFF_REPORT"

if is_waived "$target" "$report"; then
    exit 0
fi

# Claude Code PostToolUse carries a session id; remember the file so its Stop
# hook can refuse to end the turn while this is unresolved.
if [[ -n "$session" ]]; then
    record_pending "$session" "$target"
fi

{
    echo "clean-python: found issues auto-fix could not resolve in $target"
    echo
    echo "$report"
    echo
    echo "Fix the code itself. Suppression (# noqa) is ignored on this check."
    echo "If this file is off-topic, ask the user for permission to skip it."
} >&2
exit 2
