#!/usr/bin/env bash
# clean-python - one gate for agent-written Python, shared by every client.
#
# The checks live in bin/python_gate.py (modules in bin/pygate/): ruff with
# suppressions (`# noqa`) ignored, plus what ruff cannot express (file length,
# mutable dataclasses, dead code only tests use (vulture), type errors (ty)).
# This script is the hook plumbing around it: it resolves the ruff binary and
# config, and keeps the waiver, pending and settled state.
#
# Only code a change introduces is reported. The gate compares the file with
# its committed version (git HEAD) and drops findings that were already there,
# so a one-line edit to a legacy file does not demand fixing the whole file. A
# file with no committed version (new, untracked, outside git) must be fully
# clean. Auto-fix and format run only when they would not rewrite legacy code:
# the committed version is absent, or already clean (fix) / formatted (format).
#
# Phases: an edit runs the file-local checks (ruff, length, dataclasses,
# suppressions, swallowed errors); the Stop hook and the commit check also run
# vulture and ty, whose findings count only on changed lines.
#
# Config: the gate resolves ruff's config explicitly from the *git project root*
# (ruff.toml, .ruff.toml, or a pyproject.toml with a [tool.ruff] section). When
# the project root has no such file the global ruff config is used; when that is
# absent too, ruff's built-in defaults apply (--isolated). Resolving it
# explicitly keeps a stray config in a parent directory from silently changing
# the rules.
#
# Five ways in, so a single implementation serves every client:
#   clean-python <path>          explicit file (used by the opencode plugin)
#   ... | clean-python           Claude Code PostToolUse JSON on stdin
#   clean-python --stop-check    Claude Code Stop JSON on stdin
#   clean-python --waive <path>  record a user-approved "off-topic" skip
#   clean-python --staged        check staged Python files, no fixes (git
#                                pre-commit; see githooks/pre-commit)
#
# Tests also probe resolution through internal `--config-for <path>` and
# `--ruff-for <path>` modes, which print the config / ruff binary this gate
# would use.
#
# Exit 0: clean / auto-fixed / not a Python file / no pending residue (no-op).
# Exit 2: something auto-fix could not resolve -> report on stderr. For
#         --stop-check, exit 2 also refuses the Stop hook, forcing another turn.
#         For --staged, exit 1 when a staged file fails, which aborts the commit.
# No Python >= 3.14 (via uv), a missing ruff or a gate crash skips the check
# with a warning; it never blocks.
#
# The opencode plugin injects its own follow-up prompt when this exits 2, and
# its python_clean_skip tool calls `--waive` once the user approves skipping an
# off-topic file. Claude Code has no such tool, so PostToolUse records every
# file it checks in a per-session state file and the Stop hook re-checks them
# (with vulture and ty) before the turn may end. A waiver is keyed by the file's current findings, so
# it sticks across turns but expires as soon as the code changes. A file is
# dropped once it passes, is waived, or after MAX_BLOCKS refused stops, so a
# problem the agent cannot fix cannot trap the session forever.
#
# Git Bash on Windows starts every subshell and program slowly, so path
# handling below uses bash builtins and helpers return values in REPLY.
set -uo pipefail
unset CDPATH

MAX_BLOCKS=3
state_dir="${TMPDIR:-/tmp}/clean-python"
gate_script="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/python_gate.py"
is_windows=0
[[ "${OSTYPE:-}" == msys* || "${OSTYPE:-}" == cygwin* ]] && is_windows=1

# --------------------------------------------------------------------------- #
# paths (builtins only; results in REPLY)
# --------------------------------------------------------------------------- #
slashes() {
    # $1 with Windows backslashes turned into forward slashes.
    REPLY="$1"
    [[ $is_windows -eq 1 ]] && REPLY="${REPLY//\\//}"
    return 0
}

dir_of() {
    case "$1" in
        */*) REPLY="${1%/*}" ;;
        *) REPLY=. ;;
    esac
    [[ -n "$REPLY" ]] || REPLY=/
}

physical_dir() {
    # Physical absolute path of directory $1, or $1 itself when it is missing.
    local old="$PWD"
    if builtin cd -P -- "$1" 2>/dev/null; then
        REPLY="$PWD"
        builtin cd -- "$old" || true
    else
        REPLY="$1"
    fi
}

abs_path() {
    local name
    slashes "$1"
    name="${REPLY##*/}"
    dir_of "$REPLY"
    physical_dir "$REPLY"
    REPLY="${REPLY%/}/$name"
}

to_posix() {
    # git on Windows prints C:/Users/...; Git Bash's own form is /c/Users/...
    REPLY="$1"
    if [[ $is_windows -eq 1 && "$1" =~ ^([A-Za-z]):(/.*)?$ ]]; then
        local drive="${BASH_REMATCH[1]}"
        REPLY="/${drive,,}${BASH_REMATCH[2]}"
    fi
}

native_path() {
    # Windows Python cannot read MSYS paths (/c/Users/...); convert them.
    REPLY="$1"
    [[ $is_windows -eq 1 ]] || return 0
    if [[ "$1" =~ ^/([A-Za-z])(/.*)?$ ]]; then
        local drive="${BASH_REMATCH[1]}"
        REPLY="${drive^^}:${BASH_REMATCH[2]:-/}"
    elif [[ ! "$1" =~ ^[A-Za-z]: ]] && command -v cygpath >/dev/null 2>&1; then
        REPLY="$(cygpath -w "$1")"
    fi
}

# --------------------------------------------------------------------------- #
# ruff + config resolution
# --------------------------------------------------------------------------- #
has_tool_ruff() {
    local line
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ "$line" == '[tool.ruff'* ]] && return 0
    done <"$1"
    return 1
}

global_config() {
    # Ruff's user-level config, the fallback when the project root has none:
    # ~/.config/ruff on macOS and Linux, %APPDATA%/ruff on Windows.
    local cfg appdata=""
    if [[ -n "${APPDATA:-}" ]]; then
        slashes "$APPDATA"
        to_posix "$REPLY"
        appdata="$REPLY"
    fi
    REPLY=""
    for cfg in "${XDG_CONFIG_HOME:-$HOME/.config}/ruff/ruff.toml" ${appdata:+"$appdata/ruff/ruff.toml"}; do
        if [[ -f "$cfg" ]]; then
            REPLY="$cfg"
            return 0
        fi
    done
}

resolve() {
    # For the absolute path $1 set t_root (git root, or the file's directory
    # outside a repo), t_cfg (ruff config; empty = built-in defaults), t_pkg
    # (nearest pyproject.toml directory up to the git root, else the file's
    # directory) and ruff_bin (project venv, then $RUFF, then PATH; empty =
    # none). One git call.
    local dir here candidate
    dir_of "$1"
    physical_dir "$REPLY"
    dir="$REPLY"
    t_root="$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null)"
    if [[ -n "$t_root" ]]; then
        to_posix "$t_root"
        t_root="$REPLY"
    else
        t_root="$dir"
    fi

    ruff_bin=""
    for candidate in "$t_root/.venv/bin/ruff" "$t_root/.venv/Scripts/ruff.exe"; do
        if [[ -x "$candidate" ]]; then
            ruff_bin="$candidate"
            break
        fi
    done
    if [[ -z "$ruff_bin" && -n "${RUFF:-}" && -x "$RUFF" ]]; then ruff_bin="$RUFF"; fi
    if [[ -z "$ruff_bin" ]] && hash ruff 2>/dev/null; then ruff_bin="${BASH_CMDS[ruff]}"; fi

    t_cfg=""
    for candidate in "$t_root/ruff.toml" "$t_root/.ruff.toml"; do
        if [[ -f "$candidate" ]]; then
            t_cfg="$candidate"
            break
        fi
    done
    if [[ -z "$t_cfg" && -f "$t_root/pyproject.toml" ]] && has_tool_ruff "$t_root/pyproject.toml"; then
        t_cfg="$t_root/pyproject.toml"
    fi
    if [[ -z "$t_cfg" ]]; then
        global_config
        t_cfg="$REPLY"
    fi

    t_pkg="$dir"
    here="$dir"
    while :; do
        if [[ -f "$here/pyproject.toml" ]]; then
            t_pkg="$here"
            break
        fi
        [[ "$here" == "$t_root" || -e "$here/.git" || "$here" == / ]] && break
        dir_of "$here"
        here="$REPLY"
    done
}

# --------------------------------------------------------------------------- #
# the gate (bin/python_gate.py)
# --------------------------------------------------------------------------- #
gate_runner=()
gate_runner_probed=0

gate_python() {
    # Fill gate_runner with the interpreter for bin/python_gate.py, which needs
    # Python >= 3.14: uv's 3.14 first, then a python on PATH that is new enough.
    # Found once per run; leaves gate_runner empty when there is none.
    [[ $gate_runner_probed -eq 1 ]] && return
    gate_runner_probed=1
    local candidate
    if hash uv 2>/dev/null; then
        gate_runner=("${BASH_CMDS[uv]}" run --no-project --quiet --python 3.14 python)
        return
    fi
    for candidate in python3 python; do
        if "$candidate" -c 'import sys; sys.exit(sys.version_info < (3, 14))' >/dev/null 2>&1; then
            gate_runner=("$candidate")
            return
        fi
    done
}

run_gate() {
    # Run bin/python_gate.py with the given arguments; empty runner -> 127.
    gate_python
    [[ ${#gate_runner[@]} -gt 0 ]] || return 127
    PYTHONUTF8=1 "${gate_runner[@]}" "$gate_script" "$@"
}

check_report() {
    # Run the gate on the resolved file $1 in phase $2 (edit|full); further
    # arguments (--fix, --format-check) pass through. Set GATE_REPORT and
    # return 1 only when the gate exited 1 *and* reported something; anything
    # else (no Python >= 3.14, a crash, an unreadable file, a ruff failure) is
    # a skipped check with a warning, never a block.
    local file="$1" phase="$2" out status
    shift 2
    local args=()
    native_path "$file"
    args+=("$REPLY")
    native_path "$t_pkg"
    args+=("$REPLY")
    native_path "$t_root"
    args+=("$REPLY")
    native_path "$ruff_bin"
    args+=(--phase "$phase" --ruff "$REPLY")
    if [[ -n "$t_cfg" ]]; then
        native_path "$t_cfg"
        args+=(--config "$REPLY")
    fi
    GATE_REPORT=""
    out="$(run_gate "${args[@]}" "$@")"
    status=$?
    if [[ $status -eq 1 && -n "$out" ]]; then
        GATE_REPORT="$out"
        return 1
    fi
    if [[ $status -eq 127 ]]; then
        echo "clean-python: no Python >= 3.14 (or uv) found; skipping the gate" >&2
    elif [[ $status -ne 0 ]]; then
        echo "clean-python: python_gate.py failed (exit $status) on $file; checks skipped" >&2
    fi
    return 0
}

py_eval() {
    # Run the Python snippet $1 on stdin with the first interpreter that works:
    # the gate's own, then python3, then python. Windows ships a python3 Store
    # stub that only prints an install hint, so each must run to count. Warns
    # and fails when none does; callers then exit 0, so a missing python skips
    # the gate but never blocks the agent.
    local input candidate
    input="$(cat)"
    gate_python
    if [[ ${#gate_runner[@]} -gt 0 ]] && printf '%s' "$input" | PYTHONUTF8=1 "${gate_runner[@]}" -c "$1" 2>/dev/null; then
        return 0
    fi
    for candidate in python3 python; do
        printf '%s' "$input" | PYTHONUTF8=1 "$candidate" -c "$1" 2>/dev/null && return 0
    done
    echo "clean-python: no working python found; skipping the gate" >&2
    return 1
}

is_python() {
    case "$1" in
        *.py | *.pyi) return 0 ;;
        *) return 1 ;;
    esac
}

# --------------------------------------------------------------------------- #
# state: pending, settled, waivers
# --------------------------------------------------------------------------- #
state_file() {
    printf '%s/pending-%s' "$state_dir" "$(printf '%s' "$1" | tr -cd 'A-Za-z0-9._-')"
}

record_pending() {
    # $1 session id, $2 path. Idempotent; the counter belongs to --stop-check.
    local sf
    sf="$(state_file "$1")"
    mkdir -p "$state_dir" || return 0
    if [[ -f "$sf" ]] && cut -f2- "$sf" | grep -qxF "$2"; then
        return 0
    fi
    printf '0\t%s\n' "$2" >>"$sf"
}

digest() {
    # sha256 of $1. Hook environments may lack shasum (Git Bash keeps it
    # outside the default PATH), so prefer sha256sum.
    if command -v sha256sum >/dev/null 2>&1; then
        printf '%s' "$1" | sha256sum | awk '{print $1}'
    else
        printf '%s' "$1" | shasum -a 256 | awk '{print $1}'
    fi
}

settled_file() {
    printf '%s/settled-%s' "$state_dir" "$(printf '%s' "$1" | tr -cd 'A-Za-z0-9._-')"
}

mtime_of() {
    date -r "$1" +%s 2>/dev/null || echo 0
}

settle() {
    # $1 session, $2 path: the file is done (clean, waived or given up) at its
    # current mtime, so the session scan does not re-add it until it changes.
    mkdir -p "$state_dir" || return 0
    printf '%s\t%s\n' "$(mtime_of "$2")" "$2" >>"$(settled_file "$1")"
}

is_settled() {
    local sf
    sf="$(settled_file "$1")"
    [[ -f "$sf" ]] && grep -qxF "$(mtime_of "$2")"$'\t'"$2" "$sf"
}

any_waivers() {
    compgen -G "$state_dir/waived-*" >/dev/null
}

waiver_file() {
    # One waiver per absolute path; it holds the findings digests it covers.
    abs_path "$1"
    printf '%s/waived-%s' "$state_dir" "$(digest "$REPLY")"
}

edit_part() {
    # The edit phase's share of a full report: everything but vulture and ty.
    printf '%s\n' "$1" | grep -vE '^.+:[0-9]+:[0-9]+: GATE00[34] '
}

is_waived() {
    # $1 file, $2 its current findings. True when a waiver matches that digest.
    local wf want line
    any_waivers || return 1
    wf="$(waiver_file "$1")"
    [[ -f "$wf" ]] || return 1
    want="$(digest "$2")"
    while IFS= read -r line; do
        [[ "$line" == "$want" ]] && return 0
    done <"$wf"
    return 1
}

clear_waiver() {
    any_waivers || return 0
    rm -f "$(waiver_file "$1")"
}

# --------------------------------------------------------------------------- #
# Probe modes: print the ruff config / binary this gate resolves for a path
# --------------------------------------------------------------------------- #
if [[ "${1:-}" == "--config-for" || "${1:-}" == "--ruff-for" ]]; then
    abs_path "${2:-}"
    resolve "$REPLY"
    if [[ "$1" == "--config-for" ]]; then printf '%s' "$t_cfg"; else printf '%s' "$ruff_bin"; fi
    exit 0
fi

# --------------------------------------------------------------------------- #
# Waive mode: record a user-approved skip for one file's current findings.
# The waiver holds the digest of the full report (Stop hook) and of its edit
# share (PostToolUse), so both hooks honour it.
# --------------------------------------------------------------------------- #
if [[ "${1:-}" == "--waive" ]]; then
    slashes "${2:-}"
    target="$REPLY"
    [[ -n "$target" && -f "$target" ]] || exit 0
    is_python "$target" || exit 0
    abs_path "$target"
    target="$REPLY"
    resolve "$target"
    [[ -n "$ruff_bin" ]] || exit 0
    if check_report "$target" full; then
        echo "clean-python: ${target##*/} is already clean; nothing to waive." >&2
        exit 0
    fi
    report="$GATE_REPORT"
    mkdir -p "$state_dir" || exit 0
    {
        digest "$report"
        digest "$(edit_part "$report")"
    } >"$(waiver_file "$target")"
    echo "clean-python: waived ${target##*/} for its current findings." >&2
    exit 0
fi

# --------------------------------------------------------------------------- #
# Staged mode: git pre-commit check of every staged Python file, no fixes.
# The checks read the working-tree copy, so a staged file that also has
# unstaged changes is refused: what would be committed is not what was checked.
# Waivers do not apply here; `git commit --no-verify` is the deliberate escape.
# --------------------------------------------------------------------------- #
if [[ "${1:-}" == "--staged" ]]; then
    # git -C takes git's own C:/... form; MSYS argument conversion mangles a
    # /c/... path with brackets or non-ASCII. Bash-side paths use the posix form.
    repo="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
    to_posix "$repo"
    repo_posix="$REPLY"
    failed=0
    while IFS= read -r -d '' rel; do
        target="$repo_posix/$rel"
        is_python "$target" && [[ -f "$target" ]] || continue
        resolve "$target"
        if [[ -z "$ruff_bin" ]]; then
            echo "clean-python: ruff not found; skipping $rel" >&2
            continue
        fi
        if ! git -C "$repo" diff --quiet -- ":(literal)$rel"; then
            echo "$rel: has unstaged changes; stage them (or stash them) so the check sees what you commit" >&2
            failed=1
            continue
        fi
        if ! check_report "$target" full --format-check; then
            printf '%s\n' "$GATE_REPORT" >&2
            failed=1
        fi
    done < <(git -C "$repo" diff --cached --name-only -z --diff-filter=ACMR)
    if [[ $failed -ne 0 ]]; then
        echo "clean-python: commit refused; fix the findings above (suppressions are ignored)." >&2
        exit 1
    fi
    exit 0
fi

# --------------------------------------------------------------------------- #
# Stop mode: refuse to finish while Python written this session still fails
# --------------------------------------------------------------------------- #
if [[ "${1:-}" == "--stop-check" ]]; then
    payload="$(cat)"
    [[ -n "$payload" ]] || exit 0
    parsed="$(printf '%s' "$payload" | py_eval '
import json, sys
try:
    doc = json.load(sys.stdin)
except ValueError:
    doc = {}
for key in ("session_id", "transcript_path", "cwd"):
    print(doc.get(key) or "")
')" || exit 0
    { IFS= read -r session; IFS= read -r transcript; IFS= read -r cwd; } <<<"${parsed//$'\r'/}"
    [[ -n "$session" ]] || exit 0

    sf="$(state_file "$session")"
    # Files written through the shell never reach PostToolUse: add every dirty
    # Python file changed since the session started, unless it already passed
    # (or was given up on) at its current mtime.
    if [[ -n "$transcript" && -n "$cwd" ]]; then
        native_path "$transcript"
        native_transcript="$REPLY"
        native_path "$cwd"
        while IFS= read -r changed; do
            changed="${changed%$'\r'}"
            [[ -n "$changed" ]] || continue
            abs_path "$changed"
            changed="$REPLY"
            is_settled "$session" "$changed" || record_pending "$session" "$changed"
        done < <(run_gate --session-changes "$native_transcript" "$REPLY" 2>/dev/null)
    fi
    [[ -f "$sf" ]] || exit 0

    pending=""
    findings=""
    while IFS=$'\t' read -r count path; do
        [[ -n "$path" && -f "$path" ]] || continue
        abs_path "$path"
        path="$REPLY"
        resolve "$path"
        [[ -n "$ruff_bin" ]] || continue
        if check_report "$path" full; then
            clear_waiver "$path"
            settle "$session" "$path"
            continue # clean -> drop, and clear any stale waiver
        fi
        report="$GATE_REPORT"
        if is_waived "$path" "$report"; then
            settle "$session" "$path"
            continue # user approved skipping this off-topic file
        fi
        count=$((count + 1))
        if [[ "$count" -le "$MAX_BLOCKS" ]]; then
            pending+="${count}"$'\t'"${path}"$'\n'
            findings+="$report"$'\n'
        else
            settle "$session" "$path" # given up: only a new edit brings it back
        fi
    done <"$sf"

    if [[ -n "$pending" ]]; then
        printf '%s' "$pending" >"$sf"
        {
            echo "clean-python: Python you wrote still has findings that auto-fix could not resolve."
            echo
            printf '%s' "$findings"
            echo "Fix the code itself. Suppression (# noqa) is ignored on this check."
            echo "If the file is off-topic, ask the user for permission and then skip it with:"
            echo "  $0 --waive <file>"
        } >&2
        exit 2
    fi

    rm -f "$sf"
    exit 0
fi

# --------------------------------------------------------------------------- #
# target + session
# --------------------------------------------------------------------------- #
target=""
session=""
if [[ -n "${1:-}" ]]; then
    target="$1"
else
    payload="$(cat)"
    [[ -n "$payload" ]] || exit 0
    parsed="$(printf '%s' "$payload" | py_eval '
import json, sys
try:
    doc = json.load(sys.stdin)
except ValueError:
    sys.exit(0)
tool_input = doc.get("tool_input") or {}
tool_response = doc.get("tool_response") or {}
print(tool_input.get("file_path") or tool_response.get("filePath") or tool_response.get("file_path") or "")
print(doc.get("session_id") or "")
')" || exit 0
    { IFS= read -r target; IFS= read -r session; } <<<"${parsed//$'\r'/}"
fi

slashes "$target"
target="$REPLY"
[[ -n "$target" ]] || exit 0
is_python "$target" || exit 0
[[ -f "$target" ]] || exit 0
abs_path "$target"
target="$REPLY"

resolve "$target"
if [[ -z "$ruff_bin" ]]; then
    echo "clean-python: ruff not found; skipping ${target##*/}" >&2
    exit 0
fi

# --------------------------------------------------------------------------- #
# fix what we can without rewriting legacy code, then report what is new
# --------------------------------------------------------------------------- #
# Every file written in a Claude Code session is recorded for its Stop hook,
# clean or not: the edit phase skips vulture and ty, which Stop runs on it.
if check_report "$target" edit --fix; then
    clear_waiver "$target"
    [[ -n "$session" ]] && record_pending "$session" "$target"
    exit 0
fi
report="$GATE_REPORT"

if is_waived "$target" "$report"; then
    [[ -n "$session" ]] && record_pending "$session" "$target"
    exit 0
fi

# Claude Code PostToolUse carries a session id; remember the file so its Stop
# hook can refuse to end the turn while this is unresolved.
[[ -n "$session" ]] && record_pending "$session" "$target"

{
    echo "clean-python: found issues auto-fix could not resolve in $target"
    echo
    echo "$report"
    echo
    echo "Fix the code itself. Suppression (# noqa) is ignored on this check."
    echo "If this file is off-topic, ask the user for permission to skip it."
} >&2
exit 2
