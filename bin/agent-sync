#!/usr/bin/env bash
# Thin wrapper so the sync engine always has tomllib (stdlib) + tomlkit (uv).
# Usage: bin/agent-sync [--dry-run] [--client NAME]
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
UV="${UV:-/opt/homebrew/bin/uv}"
[ -x "$UV" ] || UV="$(command -v uv)"

# uv environments on Windows ship python.exe only; python3 there is the Store stub.
PY=python3
case "$(uname -s)" in MINGW* | MSYS* | CYGWIN*) PY=python ;; esac

exec "$UV" run --quiet --with tomlkit "$PY" "$DIR/bin/agent_sync.py" "$@"
