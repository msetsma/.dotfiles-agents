#!/usr/bin/env bash
# Thin wrapper for the update checker. Usage: bin/agent-update [--apply]
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
UV="${UV:-/opt/homebrew/bin/uv}"
[ -x "$UV" ] || UV="$(command -v uv)"

# uv environments on Windows ship python.exe only; python3 there is the Store stub.
PY=python3
case "$(uname -s)" in MINGW* | MSYS* | CYGWIN*) PY=python ;; esac

exec "$UV" run --quiet "$PY" "$DIR/bin/agent_update.py" "$@"
